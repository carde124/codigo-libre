# Variables de entorno del backend (formulario de contacto).
# NO pongas valores reales en este archivo: es solo la lista de nombres.
# Los valores reales se configuran en Vercel:
#   vercel.com → proyecto codigo-libre → Settings → Environment Variables

# Project URL de Supabase (Settings → API → Project URL)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# service_role key de Supabase (Settings → API → service_role).
# SECRETA: nunca en el código, nunca en el navegador, nunca en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-service-role-key

# Opcional: sal para la huella de IP del rate limiting (cualquier texto aleatorio)
RATE_LIMIT_SALT=un-texto-aleatorio-cualquiera
